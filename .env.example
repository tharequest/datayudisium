# ===== WAJIB: login admin (isi di Vercel > Settings > Environment Variables) =====
ADMIN_USERNAME=ganti-username-admin
ADMIN_PASSWORD=ganti-password-yang-kuat
# string acak minimal 32 karakter, contoh buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# ===== OPSIONAL =====
# Lama sesi admin (menit). Default 30
SESSION_MINUTES=30

# Nilai awal sebelum admin pernah menyimpan pengaturan
DEFAULT_SHEET_URL=
DEFAULT_PERIODE=I
DEFAULT_TAHUN_AJAR=2026/2027

# ===== Penyimpanan pengaturan (link spreadsheet, periode, tahun ajar) =====
# Diisi otomatis kalau kamu connect Upstash Redis / Vercel KV ke project di Vercel.
# Lokal tanpa ini: pengaturan disimpan di file .data/settings.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
